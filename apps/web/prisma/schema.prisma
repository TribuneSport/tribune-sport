generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id Int @id @default(autoincrement())

  title   String
  summary String
  content String

  category String
  image    String

  sourceUrl String @unique

  published Boolean @default(false)

  seoTitle       String?
  seoDescription String?
  slug           String? @unique

  clubId        Int?
  playerId      Int?
  competitionId Int?

  club        Club?        @relation(fields: [clubId], references: [id])
  player      Player?      @relation(fields: [playerId], references: [id])
  competition Competition? @relation(fields: [competitionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([category])
  @@index([clubId])
  @@index([playerId])
  @@index([competitionId])
}

model Club {
  id Int @id @default(autoincrement())

  externalId Int? @unique

  name String @unique
  slug String @unique

  country String
  city    String?

  stadium String?
  founded Int?

  logo   String?
  banner String?

  description String?

  articles Article[]
  players  Player[]

  homeMatches Match[] @relation("HomeClub")
  awayMatches Match[] @relation("AwayClub")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id Int @id @default(autoincrement())

  firstname String
  lastname  String
  slug      String @unique

  nationality String?

  birthDate DateTime?

  position String?

  number Int?

  photo String?

  clubId Int?

  club Club? @relation(fields: [clubId], references: [id])

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Competition {
  id Int @id @default(autoincrement())

  name String @unique
  slug String @unique

  country String?

  logo String?

  season String?

  articles Article[]
  matches  Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Match {
  id Int @id @default(autoincrement())

  competitionId Int

  homeClubId Int
  awayClubId Int

  matchDate DateTime

  homeScore Int?
  awayScore Int?

  status String

  competition Competition @relation(fields: [competitionId], references: [id])

  homeClub Club @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClub Club @relation("AwayClub", fields: [awayClubId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, homeClubId, awayClubId, matchDate])
  @@index([competitionId])
  @@index([homeClubId])
  @@index([awayClubId])
  @@index([matchDate])
}

model Standing {
  id Int @id @default(autoincrement())

  competitionId Int

  clubId Int

  position Int

  played Int @default(0)

  won Int @default(0)

  drawn Int @default(0)

  lost Int @default(0)

  goalsFor Int @default(0)

  goalsAgainst Int @default(0)

  goalDifference Int @default(0)

  points Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transfer {
  id Int @id @default(autoincrement())

  playerName String

  fromClub String

  toClub String

  fee String?

  transferDate DateTime

  createdAt DateTime @default(now())
}

model User {
  id String @id @default(cuid())

  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
}

model Account {
  id String @id @default(cuid())

  userId String

  type String

  provider String

  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String @unique

  userId String

  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String

  token String @unique

  expires DateTime

  @@unique([identifier, token])
}
